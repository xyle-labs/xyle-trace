.DS_Store
__pycache__/
*.pyc
.venv/

# Domain workloads. This repository is the toolkit and will be public: no domain
# code, no lineage database, and no captured source bytes belong in it. Consuming
# projects live outside this repository and are versioned, if at all, on their own.
projects/

# Local reference material and private working files are never shipped.
misc/

# Secrets, local credentials, captured evidence, and internal agent records.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.netrc
.npmrc
.pypirc
credentials
credentials.json
secrets.json
secrets.yaml
secrets.yml
id_rsa
id_dsa
id_ecdsa
id_ed25519
.aws/
.ssh/
.azure/
.kube/
.lineage/
.superpowers/
.claude/settings.local.json
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

