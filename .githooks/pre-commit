#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
PATH="$PWD/.venv/bin:$PATH"
export PATH
python3 scripts/check_repo.py --staged
command -v gitleaks >/dev/null 2>&1 || { echo "Install gitleaks before committing; see CONTRIBUTING.md." >&2; exit 1; }
gitleaks git --staged --redact --no-banner --config .gitleaks.toml \
    --ignore-gitleaks-allow --max-decode-depth=3 --max-archive-depth=3
